          ],
          "label": {
            "de": "Logik-Takt",
            "en": "Logic rate"
          },
          "help": {
            "de": "60 Hz nutzt die NTSC-Zeitwerte mit den PAL-Inhalten; 50 Hz ist das Original-Timing der PAL-Version.",
            "en": "60 Hz uses the NTSC timing values with the PAL content; 50 Hz is the original timing of the PAL version."
