// Resources of FuturamaLauncher.exe: original icon (launcher/tools/gen_icon.py), manifest, version info.
#include <winver.h>
#include <winuser.h>

IDI_ICON1 ICON "icon/launcher.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 3, 0, 0
PRODUCTVERSION 0, 3, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FuturamaPC Launcher"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "FuturamaLauncher"
            VALUE "OriginalFilename", "FuturamaLauncher.exe"
            VALUE "ProductName", "FuturamaPC"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
