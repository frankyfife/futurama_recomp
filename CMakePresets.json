{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "x86-base",
      "hidden": true,
      "description": "MSVC x86 + Ninja. Run from an x86 developer environment (vcvars32.bat) or use build.cmd.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug (MSVC)",
      "inherits": "x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x86-relwithdebinfo",
      "displayName": "x86 RelWithDebInfo (MSVC)",
      "inherits": "x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "x86-debug", "configurePreset": "x86-debug" },
    { "name": "x86-relwithdebinfo", "configurePreset": "x86-relwithdebinfo" }
  ]
}
